<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent for the daily database backup (docs/entwicklung.md, "Backups"). __HOME__ is replaced by the home
  directory when installing. launchd runs a missed time after the Mac wakes up (man launchd.plist).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sonjaczak.backup</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__HOME__/.local/bin/sonjaczak-backup-pull</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>12</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/sonjaczak-backup.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/sonjaczak-backup.log</string>
</dict>
</plist>
