{
	skip_install_trust

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
	log {
		{$CADDY_SERVER_LOG_OPTIONS}
		# Redact a token passed as authorization query parameter (template default, kept: tokens never belong in logs)
		format filter {
			request>uri query {
				replace authorization REDACTED
			}
			# Privacy: keep only the network part of client addresses (IPv4 /24, IPv6 /48), see the privacy policy
			request>remote_ip ip_mask 24 48
			request>client_ip ip_mask 24 48
		}
	}

	root /app/public
	encode zstd br gzip

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	@phpRoute {
		# Mercure hub for hot reload, only in development (compose.override.yaml)
		not path /.well-known/mercure*
		not file {path}
	}
	rewrite @phpRoute index.php

	@frontController path index.php
	php @frontController {
		{$FRANKENPHP_SITE_CONFIG}

		worker {
			file ./public/index.php
			{$FRANKENPHP_WORKER_CONFIG}
		}
	}

	file_server {
		hide *.php
	}
}
