#!/usr/bin/env bash
# Builds the web versions of the site's photos from the local originals in claude_references/ (not in the repository).
# Runs on the host, not in the container, because only the host has the originals. Needs ImageMagick
# (brew install imagemagick).
#
# Output per image:
#   assets/images/<name>-<width>.webp   one file per width, never wider than the original
#   assets/images/<name>.jpg            fallback for browsers without WebP
#   config/packages/images.yaml         widths and size of every image, read by the image() Twig macro
#
# Add an image: one line in IMAGES, run bin/build-images, commit assets/images/ and config/packages/images.yaml.
set -euo pipefail

cd "$(dirname "$0")/.."

SOURCE_DIR=claude_references
OUTPUT_DIR=assets/images
MANIFEST=config/packages/images.yaml
WIDTHS='640 1280 1920'
FALLBACK_WIDTH=1280
QUALITY=78

# <name>|<original, relative to SOURCE_DIR>
IMAGES='
hero-sonja|images/doris_sporer/SonjaR_175.jpg
hero-sonja2|images/doris_sporer/SonjaR_222.jpg
hero-sax|images/simon_reithofer/sonja_sax_profil.png
hero-band|red_mullet_sonja_vorne.png
hero-wedding|images/ai/wedding.png
hero-lessons|images/ai/Laughing vocal teacher with soft waves.png
'

if ! command -v magick >/dev/null; then
    echo 'ImageMagick is missing: brew install imagemagick' >&2
    exit 1
fi

# -strip removes all metadata (camera, author, GPS); -flatten gives transparent PNGs a white background
convert_image() {
    magick "$1" -auto-orient -strip -background white -flatten -resize "$2x" "${@:3}"
}

{
    echo '# Generated by bin/build-images, do not edit by hand.'
    echo '# Available widths and size (of the widest file) of every image, used by templates/_macros/image.html.twig.'
    echo 'twig:'
    echo '    globals:'
    echo '        images:'
} > "$MANIFEST"

echo "$IMAGES" | while IFS='|' read -r name source; do
    [ -z "$name" ] && continue
    file="$SOURCE_DIR/$source"
    original_width=$(magick identify -format '%w' "$file[0]")

    # Standard widths below the original, plus the original width if it is smaller than the largest standard width
    widths=''
    for width in $WIDTHS; do
        if [ "$width" -le "$original_width" ]; then
            widths="$widths $width"
        fi
    done
    largest=${WIDTHS##* }
    if [ "$original_width" -lt "$largest" ]; then
        widths="$widths $original_width"
    fi

    rm -f "$OUTPUT_DIR/$name"-*.webp
    for width in $widths; do
        convert_image "$file" "$width" -quality "$QUALITY" "$OUTPUT_DIR/$name-$width.webp"
    done

    fallback=$FALLBACK_WIDTH
    if [ "$original_width" -lt "$fallback" ]; then
        fallback=$original_width
    fi
    convert_image "$file" "$fallback" -quality "$QUALITY" -interlace JPEG "$OUTPUT_DIR/$name.jpg"

    widest=${widths##* }
    height=$(magick identify -format '%h' "$OUTPUT_DIR/$name-$widest.webp")
    width_list=$(echo $widths | sed 's/ /, /g')
    echo "            $name: { width: $widest, height: $height, widths: [$width_list] }" >> "$MANIFEST"
    echo "$name: $width_list"
done
