#!/usr/bin/env python3
"""Builds the logo "Sonja Czak" as SVG paths from the Allura font (templates/_partials/logo.svg).

Paths instead of text: the logo looks the same everywhere and needs no font download. The OFL 1.1 allows this
(OFL-FAQ: text converted to outlines is a document, not a font), the license lies in assets/fonts/allura/OFL.txt.

Runs on the host, not in the container (the image has no fontTools). Shaping with HarfBuzz applies the font's
kerning (GPOS "kern") like a browser does. Setup once, outside the repository:

    python3 -m venv ~/.venvs/sonjaczak-logo
    ~/.venvs/sonjaczak-logo/bin/pip install fonttools brotli uharfbuzz

Run: ~/.venvs/sonjaczak-logo/bin/python bin/build-logo, then commit templates/_partials/logo.svg.
"""

from io import BytesIO
from pathlib import Path

import uharfbuzz as hb
from fontTools.pens.boundsPen import BoundsPen
from fontTools.pens.svgPathPen import SVGPathPen
from fontTools.pens.transformPen import TransformPen
from fontTools.ttLib import TTFont

ROOT = Path(__file__).resolve().parent.parent
FONT = ROOT / 'assets/fonts/allura/allura-latin-400-normal.woff2'
OUTPUT = ROOT / 'templates/_partials/logo.svg'
TEXT = 'Sonja Czak'
# Room around the outlines, in font units (1000 per em), so antialiasing at the edges is not cut off
MARGIN = 10

font = TTFont(FONT)
# HarfBuzz reads TrueType, so decompress the WOFF2 first
ttf = BytesIO()
font.flavor = None
font.save(ttf)

face = hb.Face(ttf.getvalue())
buffer = hb.Buffer()
buffer.add_str(TEXT)
buffer.guess_segment_properties()
hb.shape(hb.Font(face), buffer, {'kern': True, 'liga': True})

glyph_set = font.getGlyphSet()
glyph_order = font.getGlyphOrder()
# Glyphs drawn at their shaped positions; SVG's y axis points down, so the outlines are mirrored (y -> -y)
path_pen = SVGPathPen(glyph_set)
bounds_pen = BoundsPen(glyph_set)
x = 0
for info, position in zip(buffer.glyph_infos, buffer.glyph_positions):
    glyph = glyph_set[glyph_order[info.codepoint]]
    transform = (1, 0, 0, -1, x + position.x_offset, -position.y_offset)
    glyph.draw(TransformPen(path_pen, transform))
    glyph.draw(TransformPen(bounds_pen, transform))
    x += position.x_advance

x_min, y_min, x_max, y_max = (round(value) for value in bounds_pen.bounds)
view_box = f'{x_min - MARGIN} {y_min - MARGIN} {x_max - x_min + 2 * MARGIN} {y_max - y_min + 2 * MARGIN}'

# fill="currentColor": the logo takes the text color of the theme. aria-hidden: the link around it carries the name.
OUTPUT.write_text(
    f'<!-- Generated by bin/build-logo from Allura (SIL Open Font License 1.1), do not edit by hand. -->\n'
    f'<svg xmlns="http://www.w3.org/2000/svg" viewBox="{view_box}" fill="currentColor" aria-hidden="true"'
    f' focusable="false" class="sc-logo"><path d="{path_pen.getCommands()}"/></svg>\n'
)
print(f'{OUTPUT.relative_to(ROOT)}: viewBox {view_box}, {OUTPUT.stat().st_size} bytes')
