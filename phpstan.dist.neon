# Extensions are included manually instead of via phpstan/extension-installer (avoids an extra Composer plugin)
includes:
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-symfony/rules.neon
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - vendor/phpstan/phpstan-doctrine/rules.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon

parameters:
    level: max
    # Front controllers (bin/, public/) and tests/bootstrap.php come from Flex recipes and are left as generated,
    # so that `composer recipes:update` stays conflict-free
    paths:
        - config/
        - src/
        - tests/
    excludePaths:
        - tests/bootstrap.php
    symfony:
        # Compiled dev container, lets PHPStan resolve service types; exists after the first request or cache:warmup
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    doctrine:
        # Boots the dev kernel so PHPStan knows the entity mapping: checks DQL and QueryBuilder, infers result types
        objectManagerLoader: tests/object-manager.php
        # Entities are bound to forms directly: a new Course has no date yet, so the property is nullable while the
        # column is NOT NULL; #[Assert\NotNull] keeps null out of the database. Other type mismatches are still reported.
        # Alternative would be a separate form object (DTO) per entity (docs/erklaerungen/10-datenbank-kurse.md).
        allowNullablePropertyForRequiredField: true
