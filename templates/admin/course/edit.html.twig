{% extends 'admin/base.html.twig' %}

{% set title %}{% include 'admin/course/_title.html.twig' %}{% endset %}
{% block title %}{{ title }}{% endblock %}

{% block body %}
    <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2 mb-3">
        <h1 class="h3 mb-0">{{ title }}</h1>
        <a class="btn btn-primary" href="{{ path('admin_course_grid', {id: course.id}) }}">{{ 'grid.link'|trans({}, 'admin') }}</a>
    </div>
    <div class="row g-5">
        <div class="col-lg-6">
            {{ include('admin/course/_form.html.twig', {submit_label: 'action.save'}) }}
        </div>

        <div class="col-lg-6">
            <h2 class="h5" id="ferien">{{ 'course_break.heading'|trans({}, 'admin') }}</h2>
            <p class="small text-body-secondary">{{ 'course_break.intro'|trans({}, 'admin') }}</p>
            {% if course.breaks is empty %}
                <p>{{ 'course_break.empty'|trans({}, 'admin') }}</p>
            {% else %}
                <table class="table table-sm align-middle">
                    <tbody>
                        {% for break in course.breaks %}
                            <tr>
                                <td>
                                    {{ break.firstDay|date('d.m.Y') }}
                                    {%- if break.lastDay != break.firstDay %} – {{ break.lastDay|date('d.m.Y') }}{% endif %}
                                </td>
                                <td>
                                    {{ break.label }}
                                    {% if break.source.value == 'imported' %}
                                        <span class="badge text-bg-light">{{ 'course_break.imported'|trans({}, 'admin') }}</span>
                                    {% endif %}
                                </td>
                                <td class="text-end">
                                    <form method="post" action="{{ path('admin_course_break_delete', {id: course.id, breakId: break.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete-break-' ~ break.id) }}">
                                        <button class="btn btn-link btn-sm text-danger p-0">{{ 'action.delete'|trans({}, 'admin') }}</button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}

            {# break-confirm (C4-0): asks before lessons in new breaks are deleted, then sends confirmed=1 #}
            <form method="post" action="{{ path('admin_course_break_import', {id: course.id}) }}" class="mb-4"
                  data-controller="break-confirm" data-action="break-confirm#check"
                  data-break-confirm-url-value="{{ path('admin_course_break_import_check', {id: course.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('import-breaks-' ~ course.id) }}">
                <input type="hidden" name="confirmed" value="" data-break-confirm-target="confirmed">
                <button class="btn btn-outline-secondary btn-sm">{{ 'course_break.import'|trans({}, 'admin') }}</button>
            </form>

            <h3 class="h6">{{ 'course_break.new'|trans({}, 'admin') }}</h3>
            {{ form_start(break_form, {attr: {
                'data-controller': 'break-confirm',
                'data-action': 'break-confirm#check',
                'data-break-confirm-url-value': path('admin_course_break_check', {id: course.id}),
            }}) }}
                <input type="hidden" name="confirmed" value="" data-break-confirm-target="confirmed">
                {{ form_row(break_form.label) }}
                <div class="row">
                    <div class="col-sm-6">{{ form_row(break_form.firstDay, {attr: {'data-break-confirm-target': 'firstDay'}}) }}</div>
                    <div class="col-sm-6">{{ form_row(break_form.lastDay, {attr: {'data-break-confirm-target': 'lastDay'}}) }}</div>
                </div>
                <button type="submit" class="btn btn-outline-primary">{{ 'course_break.add'|trans({}, 'admin') }}</button>
            {{ form_end(break_form) }}
        </div>
    </div>

    <h2 class="h5 mt-5">{{ 'enrollment.heading'|trans({}, 'admin') }}</h2>
    {% if course.enrollments is empty %}
        <p>{{ 'enrollment.empty'|trans({}, 'admin') }}</p>
    {% else %}
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th scope="col">{{ 'enrollment.field.slot'|trans({}, 'admin') }}</th>
                        <th scope="col">{{ 'enrollment.field.student'|trans({}, 'admin') }}</th>
                        <th scope="col">{{ 'enrollment.field.lessons'|trans({}, 'admin') }}</th>
                        <th scope="col" class="text-end">{{ 'enrollment.field.price'|trans({}, 'admin') }}</th>
                        <th scope="col">{{ 'invoice.heading'|trans({}, 'admin') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for enrollment in course.enrollments %}
                        <tr>
                            <td class="text-nowrap">{{ ('weekday_short.' ~ enrollment.weekday)|trans({}, 'admin') }} {{ enrollment.startTime|date('H:i') }}</td>
                            <td><a href="{{ path('admin_enrollment_show', {id: enrollment.id}) }}">{{ include('admin/enrollment/_student_name.html.twig') }}</a></td>
                            <td>
                                {{ include('admin/enrollment/_count.html.twig') }}
                                {% if make_ups_due[enrollment.id] > 0 %}
                                    <span class="badge text-bg-warning">{{ 'enrollment.make_up_due'|trans({'%count%': make_ups_due[enrollment.id]}, 'admin') }}</span>
                                {% endif %}
                            </td>
                            <td class="text-end">{{ (enrollment.priceCents / 100)|number_format(2, ',', '.') }} €</td>
                            <td class="text-nowrap">
                                {% set invoice = enrollment.invoices|filter(i => not i.creditNote)|first %}
                                {% if invoice %}
                                    <a href="{{ path('admin_invoice_show', {id: invoice.id}) }}">{{ invoice.displayNumber }}</a>
                                    · <a href="{{ path('admin_invoice_pdf', {id: invoice.id}) }}" download>PDF</a>
                                {% else %}
                                    <a href="{{ path('admin_invoice_new', {id: enrollment.id}) }}">{{ 'invoice.pdf.create'|trans({}, 'admin') }}</a>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {# ZIP of all invoices of the course (D2d); the hint counts enrollments without an invoice #}
        {% set without_invoice = course.enrollments|filter(e => e.invoices|filter(i => not i.creditNote) is empty)|length %}
        {% if without_invoice < course.enrollments|length %}
            <p>
                <a class="btn btn-outline-secondary btn-sm" href="{{ path('admin_course_invoices_zip', {id: course.id}) }}" download>{{ 'invoice.pdf.zip'|trans({}, 'admin') }}</a>
                {% if without_invoice > 0 %}<span class="ms-2 small text-body-secondary">{{ 'invoice.pdf.missing'|trans({'%count%': without_invoice}, 'admin') }}</span>{% endif %}
            </p>
        {% endif %}
    {% endif %}
    <a class="btn btn-outline-primary" href="{{ path('admin_enrollment_new', {id: course.id}) }}">{{ 'enrollment.new.title'|trans({}, 'admin') }}</a>

    {% if is_granted('COURSE_DELETE', course) %}
        {{ include('admin/_delete.html.twig', {
            action: path('admin_course_delete', {id: course.id}),
            token_id: 'delete-course-' ~ course.id,
            label: 'course.delete.label',
            confirm: 'course.delete.confirm',
        }) }}
    {% endif %}
{% endblock %}
