{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'course.index.title'|trans({}, 'admin') }}{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">{{ 'course.index.title'|trans({}, 'admin') }}</h1>
        <a class="btn btn-primary" href="{{ path('admin_course_new') }}">{{ 'course.index.new'|trans({}, 'admin') }}</a>
    </div>

    {% if courses is empty %}
        <p>{{ 'course.index.empty'|trans({}, 'admin') }}</p>
    {% else %}
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th scope="col">{{ 'course.field.title'|trans({}, 'admin') }}</th>
                        <th scope="col">{{ 'course.field.period'|trans({}, 'admin') }}</th>
                        <th scope="col">{{ 'course.field.room'|trans({}, 'admin') }}</th>
                        <th scope="col" class="text-end">{{ 'course.field.price'|trans({}, 'admin') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for course in courses %}
                        <tr>
                            <td><a href="{{ path('admin_course_edit', {id: course.id}) }}">{% include 'admin/course/_title.html.twig' %}</a></td>
                            <td>{{ course.startsOn|date('d.m.Y') }} – {{ course.endsOn|date('d.m.Y') }}</td>
                            <td>{{ course.room }}</td>
                            <td class="text-end">{{ (course.priceCents / 100)|number_format(2, ',', '.') }} €</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
