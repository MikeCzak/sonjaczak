{% extends 'admin/base.html.twig' %}

{% set course_title %}{% include 'admin/course/_title.html.twig' %}{% endset %}
{% block title %}{{ 'grid.title'|trans({'%course%': course_title}, 'admin') }}{% endblock %}

{% block body %}
    {# Grid controller (assets/controllers/grid_controller.js, C4d) with the session token for the endpoints (C4c)
       and the texts it shows, already translated #}
    <div class="course-grid-page" data-controller="grid"
         data-grid-token-value="{{ csrf_token('lesson-grid-' ~ course.id) }}"
         data-grid-confirm-delete-value="{{ 'grid.confirm.delete'|trans({}, 'admin') }}"
         data-grid-error-value="{{ 'grid.error.request'|trans({}, 'admin') }}">
    <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2 mb-3">
        <h1 class="h3 mb-0">{{ 'grid.title'|trans({'%course%': course_title}, 'admin') }}</h1>
        <a href="{{ path('admin_course_edit', {id: course.id}) }}">{{ 'grid.to_course'|trans({}, 'admin') }}</a>
    </div>

    {% if trials is not empty %}
        <p class="small mb-3">
            <strong>{{ 'grid.trials'|trans({}, 'admin') }}:</strong>
            {% for trial in trials %}
                <a href="{{ path('admin_trial_edit', {id: trial.id}) }}">{{ trial.student.fullName }}, {{ ('weekday_short.' ~ trial.startsAt|date('N'))|trans({}, 'admin') }} {{ trial.startsAt|date('d.m. H:i') }}</a>{{ not loop.last ? ' · ' }}
            {% endfor %}
        </p>
    {% endif %}

    {% if grid.columns is empty %}
        <p>{{ 'enrollment.empty'|trans({}, 'admin') }}</p>
    {% else %}
        <div class="table-responsive grid-wrap">
            <table class="table table-sm table-bordered align-top course-grid">
                <thead>
                    <tr>
                        <th scope="col" class="grid-week">{{ 'grid.week'|trans({}, 'admin') }}</th>
                        {% for column in grid.columns %}
                            <th scope="col" class="grid-slot">
                                <span class="d-block">{{ ('weekday_short.' ~ column.weekday)|trans({}, 'admin') }} {{ column.startTime }}</span>
                                {% for enrollment in column.enrollments %}
                                    <span class="d-block small fw-normal">
                                        <a href="{{ path('admin_enrollment_show', {id: enrollment.id}) }}">{{ enrollment.student.fullName }}</a>
                                        · {{ include('admin/enrollment/_count.html.twig') }}
                                        {% if make_ups_due[enrollment.id] > 0 %}
                                            <span class="badge text-bg-warning">{{ 'enrollment.make_up_due'|trans({'%count%': make_ups_due[enrollment.id]}, 'admin') }}</span>
                                        {% endif %}
                                    </span>
                                {% endfor %}
                            </th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% for row in grid.rows %}
                        <tr class="{{ row.breaks is not empty ? 'grid-row--break' }} {{ row.current ? 'grid-row--current' }}">
                            <th scope="row" class="grid-week">
                                <span class="d-block">{{ 'grid.week_number'|trans({'%week%': row.weekStart|date('W')}, 'admin') }}</span>
                                <span class="d-block small fw-normal text-body-secondary">{{ row.weekStart|date('d.m.') }}–{{ row.weekEnd|date('d.m.') }}</span>
                                {% for break in row.breaks %}
                                    <span class="badge text-bg-secondary text-wrap">{{ break.label }}</span>
                                {% endfor %}
                                {# C4e: the break form on the course page, prefilled with this week; back here after saving #}
                                <a class="d-block small fw-normal" title="{{ 'course_break.week_link_title'|trans({}, 'admin') }}"
                                   href="{{ path('admin_course_edit', {id: course.id, ferien_von: row.weekStart|date('Y-m-d'), ferien_bis: row.weekEnd|date('Y-m-d'), zurueck: 'raster'}) }}#ferien">{{ 'course_break.week_link'|trans({}, 'admin') }}</a>
                            </th>
                            {% for column in grid.columns %}
                                <td>
                                    {% for lesson in row.cells[column.key] ?? [] %}
                                        {{ include('admin/course/_grid_lesson.html.twig') }}
                                    {% endfor %}
                                    {% if row.doubleOffers[column.key] is defined %}
                                        <div class="grid-doubles d-flex justify-content-between gap-1">
                                            {% for offer in row.doubleOffers[column.key] %}
                                                <button type="button" class="btn btn-sm btn-outline-secondary grid-double grid-double--{{ offer.position }}"
                                                        data-action="grid#double"
                                                        data-grid-url-param="{{ path('admin_lesson_double', {id: offer.lesson.id}) }}"
                                                        data-grid-position-param="{{ offer.position }}"
                                                        title="{{ 'grid.double.title'|trans({'%name%': offer.lesson.enrollment.student.fullName}, 'admin') }}">
                                                    {{- ('grid.double.' ~ offer.position)|trans({'%name%': offer.lesson.enrollment.student.firstName}, 'admin') -}}
                                                </button>
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                </td>
                            {% endfor %}
                        </tr>
                        {% if row.hasCancelled %}
                            <tr class="grid-row--cancelled">
                                <th scope="row" class="grid-week small fw-normal">{{ 'grid.cancelled'|trans({}, 'admin') }}</th>
                                {% for column in grid.columns %}
                                    <td>
                                        {% for lesson in row.cancelled[column.key] ?? [] %}
                                            {{ include('admin/course/_grid_lesson.html.twig') }}
                                        {% endfor %}
                                    </td>
                                {% endfor %}
                            </tr>
                        {% endif %}
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <p class="small text-body-secondary">{{ 'grid.help'|trans({}, 'admin') }}</p>

        {# Editor for one lesson, cloned into the cell by the grid controller #}
        <template data-grid-target="editor">
            <div class="grid-editor mt-1 p-2 border rounded bg-body">
                <div class="d-flex flex-wrap gap-1 mb-2" role="group" aria-label="{{ 'lesson.field.cancelled_by'|trans({}, 'admin') }}">
                    {% for value in ['student', 'teacher'] %}
                        <button type="button" class="btn btn-sm btn-outline-danger" aria-pressed="false"
                                data-cancel="{{ value }}" data-action="grid#toggleCancel">{{ ('lesson.cancelled_by.' ~ value)|trans({}, 'admin') }}</button>
                    {% endfor %}
                </div>
                <textarea class="form-control form-control-sm mb-2" rows="2" data-note-input
                          aria-label="{{ 'lesson.field.note'|trans({}, 'admin') }}"
                          placeholder="{{ 'lesson.field.note'|trans({}, 'admin') }}"></textarea>
                <p class="text-danger small mb-2" data-error hidden></p>
                <div class="d-flex flex-wrap align-items-center gap-1">
                    <button type="button" class="btn btn-sm btn-primary" data-action="grid#save">{{ 'action.save'|trans({}, 'admin') }}</button>
                    <button type="button" class="btn btn-sm btn-outline-success" data-uncancel data-action="grid#uncancel" hidden>{{ 'grid.uncancel'|trans({}, 'admin') }}</button>
                    <button type="button" class="btn btn-sm btn-link" data-action="grid#close">{{ 'action.cancel'|trans({}, 'admin') }}</button>
                    <a class="btn btn-sm btn-link" data-edit-link>{{ 'grid.more'|trans({}, 'admin') }}</a>
                    <button type="button" class="btn btn-sm btn-link text-danger ms-auto" data-action="grid#remove">{{ 'action.delete'|trans({}, 'admin') }}</button>
                </div>
            </div>
        </template>
    {% endif %}
    </div>
{% endblock %}
