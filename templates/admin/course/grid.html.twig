{% extends 'admin/base.html.twig' %}

{% set course_title %}{% include 'admin/course/_title.html.twig' %}{% endset %}
{% block title %}{{ 'grid.title'|trans({'%course%': course_title}, 'admin') }}{% endblock %}

{% block body %}
    {# Grid controller (assets/controllers/grid_controller.js, C4d) with the session token for the endpoints (C4c)
       and the texts it shows, already translated #}
    <div class="course-grid-page" data-controller="grid" data-action="keydown.esc@window->grid#escape click@window->grid#outside"
         data-grid-token-value="{{ csrf_token('lesson-grid-' ~ course.id) }}"
         data-grid-confirm-delete-value="{{ 'grid.confirm.delete'|trans({}, 'admin') }}"
         data-grid-error-value="{{ 'grid.error.request'|trans({}, 'admin') }}">
    <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2 mb-3">
        <h1 class="h3 mb-0">{{ 'grid.title'|trans({'%course%': course_title}, 'admin') }}</h1>
        <a href="{{ path('admin_course_edit', {id: course.id}) }}">{{ 'grid.to_course'|trans({}, 'admin') }}</a>
    </div>

    {% if grid.empty %}
        <p>{{ 'enrollment.empty'|trans({}, 'admin') }}</p>
    {% else %}
        <div class="table-responsive grid-wrap">
            <table class="table table-sm table-bordered align-top course-grid">
                <thead>
                    <tr>
                        <th scope="col" class="grid-week">{{ 'grid.week'|trans({}, 'admin') }}</th>
                        <th scope="col" class="grid-day">{{ 'grid.day'|trans({}, 'admin') }}</th>
                        <th scope="col" class="grid-timeline">
                            {# Hour labels on the same axis as the days below #}
                            <div class="grid-track grid-track--hours" style="--length: {{ grid.axis.length }}">
                                {% for hour in grid.axis.hours %}
                                    <span class="grid-hour-label {{ loop.first ? 'grid-hour-label--first' }} {{ loop.last ? 'grid-hour-label--last' }}" style="--at: {{ hour - grid.axis.startMinute }}">{{ '%02d:00'|format(hour // 60) }}</span>
                                {% endfor %}
                            </div>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    {# One row per teaching day, grouped by calendar week (C4f). The week cell spans the days and their
                       rows of cancelled lessons. A break on every teaching day of the week is named there, once;
                       otherwise on the day it falls on. Each day is a time axis with boxes (C4g) #}
                    {% for week in grid.weeks %}
                        {% set whole_break = week.wholeBreak %}
                        {% for row in week.rows %}
                            <tr class="{{ row.breaks is not empty ? 'grid-row--break' }} {{ row.today ? 'grid-row--today' }}">
                                {% if loop.first %}
                                    <th scope="rowgroup" rowspan="{{ week.rowspan }}" class="grid-week {{ whole_break ? 'grid-week--break' }} {{ week.current ? 'grid-week--current' }}">
                                        <span class="d-block">{{ 'grid.week_number'|trans({'%week%': week.weekStart|date('W')}, 'admin') }}</span>
                                        <span class="d-block small fw-normal text-body-secondary">{{ week.weekStart|date('d.m.') }}–{{ week.weekEnd|date('d.m.') }}</span>
                                        {% if whole_break %}
                                            {% for break in week.breaks %}
                                                <span class="badge text-bg-secondary text-wrap">{{ break.label }}</span>
                                            {% endfor %}
                                        {% endif %}
                                        {# C4e: the break form on the course page, prefilled with this week; back here after saving #}
                                        <a class="d-block small fw-normal" title="{{ 'course_break.week_link_title'|trans({}, 'admin') }}"
                                           href="{{ path('admin_course_edit', {id: course.id, ferien_von: week.weekStart|date('Y-m-d'), ferien_bis: week.weekEnd|date('Y-m-d'), zurueck: 'raster'}) }}#ferien">{{ 'course_break.week_link'|trans({}, 'admin') }}</a>
                                    </th>
                                {% endif %}
                                <th scope="row" class="grid-day">
                                    <span class="d-block">{{ ('weekday_short.' ~ row.weekday)|trans({}, 'admin') }} {{ row.day|date('d.m.') }}</span>
                                    {% if not whole_break %}
                                        {% for break in row.breaks %}
                                            <span class="badge text-bg-secondary text-wrap">{{ break.label }}</span>
                                        {% endfor %}
                                    {% endif %}
                                </th>
                                <td class="grid-timeline">
                                    {{ include('admin/course/_grid_track.html.twig', {axis: grid.axis, items: row.items, lanes: row.lanes, compact: false, day: row.day}) }}
                                </td>
                            </tr>
                            {% if row.hasCancelled %}
                                <tr class="grid-row--cancelled">
                                    <th scope="row" class="grid-day small fw-normal">{{ 'grid.cancelled'|trans({}, 'admin') }}</th>
                                    <td class="grid-timeline">
                                        {{ include('admin/course/_grid_track.html.twig', {axis: grid.axis, items: row.cancelled, lanes: row.cancelledLanes, compact: true, day: row.day}) }}
                                    </td>
                                </tr>
                            {% endif %}
                        {% endfor %}
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <p class="small text-body-secondary">{{ 'grid.help'|trans({}, 'admin') }}</p>

        {# Editor for one lesson, cloned by the grid controller and shown floating below the box (C4g) #}
        <template data-grid-target="editor">
            <div class="grid-editor p-2 border rounded bg-body shadow-sm">
                <div class="d-flex flex-wrap gap-1 mb-2" role="group" aria-label="{{ 'lesson.field.cancelled_by'|trans({}, 'admin') }}">
                    {% for value in ['student', 'teacher'] %}
                        <button type="button" class="btn btn-sm btn-outline-danger" aria-pressed="false"
                                data-cancel="{{ value }}" data-action="grid#toggleCancel">{{ ('lesson.cancelled_by.' ~ value)|trans({}, 'admin') }}</button>
                    {% endfor %}
                </div>
                <textarea class="form-control form-control-sm mb-2" rows="2" data-note-input
                          aria-label="{{ 'lesson.field.note'|trans({}, 'admin') }}"
                          placeholder="{{ 'lesson.field.note'|trans({}, 'admin') }}"></textarea>
                <p class="text-danger small mb-2" data-error hidden></p>
                <div class="d-flex flex-wrap align-items-center gap-1">
                    <button type="button" class="btn btn-sm btn-primary" data-action="grid#save">{{ 'action.save'|trans({}, 'admin') }}</button>
                    <button type="button" class="btn btn-sm btn-outline-success" data-uncancel data-action="grid#uncancel" hidden>{{ 'grid.uncancel'|trans({}, 'admin') }}</button>
                    <button type="button" class="btn btn-sm btn-link" data-action="grid#cancel">{{ 'action.cancel'|trans({}, 'admin') }}</button>
                    <a class="btn btn-sm btn-link" data-edit-link>{{ 'grid.more'|trans({}, 'admin') }}</a>
                    <button type="button" class="btn btn-sm btn-link text-danger ms-auto" data-action="grid#remove">{{ 'action.delete'|trans({}, 'admin') }}</button>
                </div>
            </div>
        </template>
    {% endif %}
    </div>
{% endblock %}
