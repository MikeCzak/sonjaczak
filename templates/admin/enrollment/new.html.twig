{% extends 'admin/base.html.twig' %}

{% set course_title %}{% include 'admin/course/_title.html.twig' %}{% endset %}
{% block title %}{{ 'enrollment.new.title'|trans({}, 'admin') }}{% endblock %}

{% block body %}
    <h1 class="h3 mb-3">{{ enrollment.student.fullName }}: {{ course_title }}</h1>
    <p>{{ 'enrollment.new.intro'|trans({'%count%': course.plannedLessons}, 'admin') }}</p>
    <div class="row">
        <div class="col-lg-8">
            {{ form_start(form) }}
                {{ include('admin/enrollment/_fields.html.twig') }}
                <button type="submit" class="btn btn-primary">{{ 'enrollment.new.submit'|trans({}, 'admin') }}</button>
                <a class="btn btn-link" href="{{ path('admin_course_edit', {id: course.id}) }}">{{ 'action.cancel'|trans({}, 'admin') }}</a>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
