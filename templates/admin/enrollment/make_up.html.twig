{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'lesson.make_up_new'|trans({}, 'admin') }}{% endblock %}

{% block body %}
    <h1 class="h3 mb-3">{{ 'lesson.make_up_new'|trans({}, 'admin') }}: {{ enrollment.student.fullName }}</h1>
    <div class="row">
        <div class="col-md-8 col-lg-5">
            {{ form_start(form) }}
                {{ form_rest(form) }}
                <button type="submit" class="btn btn-primary">{{ 'action.save'|trans({}, 'admin') }}</button>
                <a class="btn btn-link" href="{{ path('admin_enrollment_show', {id: enrollment.id}) }}">{{ 'action.cancel'|trans({}, 'admin') }}</a>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
