{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'account.title'|trans({}, 'admin') }}{% endblock %}

{% block body %}
    <h1 class="h3 mb-4">{{ 'account.title'|trans({}, 'admin') }}</h1>
    <p>{{ 'account.email'|trans({}, 'admin') }}: {{ app.user.userIdentifier }}</p>

    <div class="row">
        <div class="col-md-8 col-lg-5">
            <h2 class="h5 mt-4">{{ 'account.password_heading'|trans({}, 'admin') }}</h2>
            {{ form_start(form) }}
                {{ form_rest(form) }}
                <button type="submit" class="btn btn-primary">{{ 'account.password_submit'|trans({}, 'admin') }}</button>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
