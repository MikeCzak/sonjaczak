{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'password.request.title'|trans({}, 'admin') }}{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-sm-10 col-md-6 col-lg-4">
            <h1 class="h3 mb-3">{{ 'password.request.title'|trans({}, 'admin') }}</h1>
            <p>{{ 'password.request.intro'|trans({}, 'admin') }}</p>
            {{ form_start(form) }}
                {{ form_row(form.email) }}
                <button type="submit" class="btn btn-primary">{{ 'password.request.submit'|trans({}, 'admin') }}</button>
            {{ form_end(form) }}
            <p class="mt-3"><a href="{{ path('admin_login') }}">{{ 'password.back_to_login'|trans({}, 'admin') }}</a></p>
        </div>
    </div>
{% endblock %}
