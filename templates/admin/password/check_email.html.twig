{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'password.check_email.title'|trans({}, 'admin') }}{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-sm-10 col-md-6 col-lg-4">
            <h1 class="h3 mb-3">{{ 'password.check_email.title'|trans({}, 'admin') }}</h1>
            {# Same text whether an account exists or not #}
            <p>{{ 'password.check_email.body'|trans({'%time%': resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle')}, 'admin') }}</p>
            <p><a href="{{ path('admin_login') }}">{{ 'password.back_to_login'|trans({}, 'admin') }}</a></p>
        </div>
    </div>
{% endblock %}
