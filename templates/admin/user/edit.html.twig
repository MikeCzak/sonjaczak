{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'user.edit.title'|trans({}, 'admin') }}{% endblock %}

{% block body %}
    <h1 class="h3 mb-3">{{ 'user.edit.title'|trans({}, 'admin') }}</h1>
    {% if not can_change_access %}
        <p class="text-body-secondary">{{ 'user.flash.own_account'|trans({}, 'admin') }}</p>
    {% endif %}
    <div class="row">
        <div class="col-md-8 col-lg-5">
            {{ form_start(form) }}
                {{ form_rest(form) }}
                <button type="submit" class="btn btn-primary">{{ 'action.save'|trans({}, 'admin') }}</button>
                <a class="btn btn-link" href="{{ path('admin_user_index') }}">{{ 'action.cancel'|trans({}, 'admin') }}</a>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
