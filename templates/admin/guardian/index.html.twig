{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'guardian.index.title'|trans({}, 'admin') }}{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">{{ 'guardian.index.title'|trans({}, 'admin') }}</h1>
        <a class="btn btn-primary" href="{{ path('admin_guardian_new') }}">{{ 'guardian.index.new'|trans({}, 'admin') }}</a>
    </div>

    {% if guardians is empty %}
        <p>{{ 'guardian.index.empty'|trans({}, 'admin') }}</p>
    {% else %}
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th scope="col">{{ 'guardian.field.name'|trans({}, 'admin') }}</th>
                        <th scope="col">{{ 'person.email'|trans({}, 'admin') }}</th>
                        <th scope="col">{{ 'guardian.field.students'|trans({}, 'admin') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for guardian in guardians %}
                        <tr>
                            <td><a href="{{ path('admin_guardian_edit', {id: guardian.id}) }}">{{ guardian.name }}</a></td>
                            <td>{{ guardian.email }}</td>
                            <td>{{ guardian.students|map(s => s.fullName)|join(', ') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
