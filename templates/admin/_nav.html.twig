{# Main navigation of the admin area. An entry is active for all routes starting with its prefix;
   entries with a role are only shown to accounts that have it. #}
{% set current = app.request.attributes.get('_route') %}
{% set entries = [
    {route: 'admin_dashboard', prefix: 'admin_dashboard', label: 'nav.dashboard'},
    {route: 'admin_course_index', prefix: 'admin_course_', label: 'nav.courses'},
    {route: 'admin_trial_index', prefix: 'admin_trial_', label: 'nav.trials'},
    {route: 'admin_student_index', prefix: 'admin_student_', label: 'nav.students'},
    {route: 'admin_guardian_index', prefix: 'admin_guardian_', label: 'nav.guardians'},
    {route: 'admin_invoice_index', prefix: 'admin_invoice_', label: 'nav.invoices'},
    {route: 'admin_settings', prefix: 'admin_settings', label: 'nav.settings'},
    {route: 'admin_user_index', prefix: 'admin_user_', label: 'nav.users', role: 'ROLE_SUPER_ADMIN'},
] %}
{% for entry in entries|filter(entry => entry.role is not defined or is_granted(entry.role)) %}
    {% set active = current starts with entry.prefix %}
    <li class="nav-item">
        <a class="nav-link{{ active ? ' active' }}" href="{{ path(entry.route) }}"
           {%- if active %} aria-current="page"{% endif %}>{{ entry.label|trans({}, 'admin') }}</a>
    </li>
{% endfor %}
