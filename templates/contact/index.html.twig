{% extends 'base.html.twig' %}
{% import '_macros/text.html.twig' as text %}

{% block title %}{{ 'title.contact'|trans }}{% endblock %}
{% block meta_description %}{{ 'meta.contact'|trans }}{% endblock %}

{% block body %}
    <section class="sc-section">
        <div class="container">
            <h1>{{ 'title.contact'|trans }}</h1>
            <hr class="sc-accent-line">
            <p class="col-lg-8 fs-5">{{ 'contact.intro'|trans({}, 'content') }}</p>
            <p><a class="btn btn-primary" href="mailto:{{ contact_email }}">{{ contact_email }}</a></p>

            <p class="col-lg-8 mt-5">{{ 'contact.hint'|trans({}, 'content') }}</p>
            <ul class="sc-list">
                <li><a href="{{ path('app_booking_solo') }}">{{ 'title.booking_solo'|trans }}</a></li>
                <li><a href="{{ path('app_booking_band') }}">{{ 'title.booking_band'|trans }}</a></li>
                <li><a href="{{ path('app_lessons') }}">{{ 'title.lessons'|trans }}</a></li>
            </ul>
        </div>
    </section>

    <section id="impressum" class="sc-section sc-section--surface">
        <div class="container">
            <h2>{{ 'title.imprint'|trans }}</h2>
            <hr class="sc-accent-line">
            <div class="row g-5">
                <div class="col-md-6">
                    <h3 class="h5">{{ 'imprint.provider.heading'|trans({}, 'content') }}</h3>
                    {{ include('_partials/controller_address.html.twig') }}
                    <p>{{ 'imprint.provider.purpose'|trans({}, 'content') }}</p>
                    {% set profession = 'imprint.profession'|trans({}, 'content') %}
                    {% if profession is not empty %}
                        {{ text.paragraphs(profession) }}
                    {% endif %}
                </div>
                <div class="col-md-6">
                    <h3 class="h5">{{ 'imprint.credits.heading'|trans({}, 'content') }}</h3>
                    <p>{{ 'imprint.credits.body'|trans({}, 'content') }}</p>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
