{% extends 'base.html.twig' %}
{% import '_macros/image.html.twig' as media %}
{% import '_macros/text.html.twig' as text %}

{% block title %}{{ 'title.booking_solo'|trans }}{% endblock %}
{% block meta_description %}{{ 'meta.booking_solo'|trans }}{% endblock %}

{% block body %}
    <section class="sc-hero">
        {{ media.image('hero-wedding', '', {class: 'sc-hero__image', position: '70% 40%', priority: true}) }}
        <div class="container pb-5">
            <h1>{{ 'title.booking_solo'|trans }}</h1>
            <p class="col-lg-7 fs-5 mb-0"{{ page_text_attr('booking_solo.intro') }}>{{ 'booking_solo.intro'|trans({}, 'content') }}</p>
        </div>
    </section>

    <section class="sc-section">
        <div class="container">
            <div class="row g-5">
                <div class="col-md-6">
                    <h2{{ page_text_attr('booking_solo.occasions.heading') }}>{{ 'booking_solo.occasions.heading'|trans({}, 'content') }}</h2>
                    <hr class="sc-accent-line">
                    {{ text.list('booking_solo.occasions.items'|trans({}, 'content'), 'sc-list', page_text_attr('booking_solo.occasions.items')) }}
                </div>
                <div class="col-md-6">
                    <h2{{ page_text_attr('booking_solo.services.heading') }}>{{ 'booking_solo.services.heading'|trans({}, 'content') }}</h2>
                    <hr class="sc-accent-line">
                    {{ text.list('booking_solo.services.items'|trans({}, 'content'), 'sc-list', page_text_attr('booking_solo.services.items')) }}
                    <p class="text-body-secondary"{{ page_text_attr('booking_solo.services.note') }}>{{ 'booking_solo.services.note'|trans({}, 'content') }}</p>
                </div>
            </div>
        </div>
    </section>

    <section class="sc-section sc-section--surface">
        <div class="container">
            <h2{{ page_text_attr('booking_solo.region.heading') }}>{{ 'booking_solo.region.heading'|trans({}, 'content') }}</h2>
            <hr class="sc-accent-line">
            <p class="col-lg-8 mb-0"{{ page_text_attr('booking_solo.region.body') }}>{{ 'booking_solo.region.body'|trans({}, 'content') }}</p>
        </div>
    </section>

    <section class="sc-section">
        <div class="container">
            <h2{{ page_text_attr('booking_solo.process.heading') }}>{{ 'booking_solo.process.heading'|trans({}, 'content') }}</h2>
            <hr class="sc-accent-line">
            <ol class="sc-steps col-lg-8"{{ page_text_attr('booking_solo.process.items') }}>
                {%- for step in 'booking_solo.process.items'|trans({}, 'content')|split("\n") -%}
                    <li>{{ step }}</li>
                {%- endfor -%}
            </ol>

            <div class="accordion col-lg-8 mt-5" id="cancellation">
                <div class="accordion-item">
                    {# Marked on the h2, not the button: the edit button must not sit inside another button #}
                    <h2 class="accordion-header"{{ page_text_attr('booking_solo.cancellation.heading') }}>
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                data-bs-target="#cancellation-body" aria-expanded="false" aria-controls="cancellation-body">
                            {{ 'booking_solo.cancellation.heading'|trans({}, 'content') }}
                        </button>
                    </h2>
                    <div id="cancellation-body" class="accordion-collapse collapse" data-bs-parent="#cancellation">
                        <div class="accordion-body">
                            <p{{ page_text_attr('booking_solo.cancellation.intro') }}>{{ 'booking_solo.cancellation.intro'|trans({}, 'content') }}</p>
                            {{ text.list('booking_solo.cancellation.items'|trans({}, 'content'), '', page_text_attr('booking_solo.cancellation.items')) }}
                            {{ text.list('booking_solo.cancellation.clauses'|trans({}, 'content'), 'mb-0', page_text_attr('booking_solo.cancellation.clauses')) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="sc-section sc-section--surface">
        <div class="container">
            <h2{{ page_text_attr('booking_solo.inquiry.heading') }}>{{ 'booking_solo.inquiry.heading'|trans({}, 'content') }}</h2>
            <hr class="sc-accent-line">
            <div class="col-lg-8">
                <p{{ page_text_attr('booking_solo.inquiry.body') }}>{{ 'booking_solo.inquiry.body'|trans({}, 'content') }}</p>
                {{ include('_partials/inquiry_form.html.twig', {
                    form: form,
                    status: inquiry_status,
                    sent: inquiry_sent,
                    page_url: path('app_booking_solo'),
                    address: 'formal',
                }) }}
            </div>
        </div>
    </section>
{% endblock %}
