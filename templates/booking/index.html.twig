{% extends 'base.html.twig' %}

{% block title %}{{ 'title.booking'|trans }}{% endblock %}
{% block meta_description %}{{ 'meta.booking'|trans }}{% endblock %}

{% block body %}
    <div class="container pt-5 pb-4">
        <h1>{{ 'title.booking'|trans }}</h1>
        <hr class="sc-accent-line mb-0">
    </div>

    {{ include('booking/_section.html.twig', {
        image: 'hero-wedding',
        position: '70% 40%',
        priority: true,
        heading: 'title.booking_solo'|trans,
        body: 'booking.solo.body'|trans({}, 'content'),
        url: path('app_booking_solo'),
    }) }}
    {{ include('booking/_section.html.twig', {
        image: 'hero-band',
        position: '75% 20%',
        priority: false,
        heading: 'title.booking_band'|trans,
        body: 'booking.band.body'|trans({}, 'content'),
        url: path('app_booking_band'),
    }) }}
{% endblock %}
