{# Name, address and e-mail of the site owner, shared by imprint and privacy policy #}
<address>
    <span{{ page_text_attr('imprint.provider.name') }}>{{ 'imprint.provider.name'|trans({}, 'content') }}</span><br>
    <span{{ page_text_attr('imprint.provider.address') }}>{{ 'imprint.provider.address'|trans({}, 'content')|nl2br }}</span><br>
    {{ 'footer.email'|trans }}: <a href="mailto:{{ contact_email }}">{{ contact_email }}</a>
</address>
