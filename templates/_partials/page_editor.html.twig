{# Editing page texts in place (docs/planung/cms.md K4), only for admins (templates/base.html.twig).
   A small bar at the bottom switches edit mode on and off; the Stimulus controller page_editor then puts a button
   on every element marked with page_text_attr() and opens the editor below it. All texts come translated from here. #}
<div class="sc-page-editor" data-controller="page-editor"
     data-page-editor-base-url-value="{{ path('admin_page_text_index') }}"
     data-page-editor-token-value="{{ csrf_token('page-text') }}"
     data-page-editor-error-value="{{ 'page_text.editor.error'|trans({}, 'admin') }}"
     data-page-editor-confirm-reset-value="{{ 'page_text.reset.confirm'|trans({}, 'admin') }}"
     data-page-editor-edit-label-value="{{ 'page_text.editor.edit'|trans({}, 'admin') }}">
    <div class="sc-page-editor__bar bg-body border rounded-pill shadow-sm px-3 py-2 d-flex align-items-center gap-3 small">
        <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" role="switch" id="page-editor-switch"
                   data-page-editor-target="switch" data-action="page-editor#toggle">
            <label class="form-check-label" for="page-editor-switch">{{ 'page_text.editor.switch'|trans({}, 'admin') }}</label>
        </div>
        <a href="{{ path('admin_dashboard') }}">{{ 'page_text.editor.admin'|trans({}, 'admin') }}</a>
    </div>

    <template data-page-editor-target="panel">
        {# Inserted next to the text, outside this controller element: data-action would not work there, the controller
           attaches the events itself (data-cancel, data-reset) #}
        <form class="sc-page-editor__panel card shadow p-3 my-3 text-start">
            <p class="fw-semibold mb-1" data-label></p>
            <p class="mb-2" data-changed hidden><span class="badge text-bg-warning"></span></p>
            <label class="visually-hidden" for="page-editor-text">{{ 'page_text.field.body'|trans({}, 'admin') }}</label>
            <textarea class="form-control" id="page-editor-text" rows="6" data-text></textarea>
            <div class="invalid-feedback d-block" data-errors></div>
            <p class="small text-body-secondary mt-2 mb-1" data-hint></p>
            <p class="small text-body-secondary mb-1" data-placeholders hidden></p>
            <details class="small mb-3">
                <summary>{{ 'page_text.edit.default'|trans({}, 'admin') }}</summary>
                <div class="border rounded p-2 mt-1 bg-body-tertiary" style="white-space: pre-line" data-default></div>
            </details>
            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary btn-sm">{{ 'action.save'|trans({}, 'admin') }}</button>
                <button type="button" class="btn btn-outline-secondary btn-sm" data-cancel>{{ 'action.cancel'|trans({}, 'admin') }}</button>
                <button type="button" class="btn btn-outline-danger btn-sm ms-auto" data-reset hidden>{{ 'page_text.reset.label'|trans({}, 'admin') }}</button>
            </div>
        </form>
    </template>
</div>
