{% extends 'base.html.twig' %}
{% import '_macros/image.html.twig' as media %}
{% import '_macros/text.html.twig' as text %}

{% block title %}{{ 'title.lessons'|trans }}{% endblock %}
{% block meta_description %}{{ 'meta.lessons'|trans }}{% endblock %}

{% block body %}
    <section class="sc-hero">
        {{ media.image('hero-lessons', '', {class: 'sc-hero__image', position: '70% 35%', priority: true}) }}
        <div class="container pb-5">
            <h1>{{ 'title.lessons'|trans }}</h1>
        </div>
    </section>

    <section class="sc-section">
        <div class="container">
            <p class="col-lg-8 fs-5"{{ page_text_attr('lessons.intro') }}>{{ 'lessons.intro'|trans({}, 'content') }}</p>
            <div class="row g-5 mt-0">
                <div class="col-md-6">
                    <h2{{ page_text_attr('lessons.content.heading') }}>{{ 'lessons.content.heading'|trans({}, 'content') }}</h2>
                    <hr class="sc-accent-line">
                    {{ text.list('lessons.content.items'|trans({}, 'content'), 'sc-list', page_text_attr('lessons.content.items')) }}
                    <p{{ page_text_attr('lessons.content.styles') }}>{{ 'lessons.content.styles'|trans({}, 'content') }}</p>
                </div>
                <div class="col-md-6">
                    <h2{{ page_text_attr('lessons.audience.heading') }}>{{ 'lessons.audience.heading'|trans({}, 'content') }}</h2>
                    <hr class="sc-accent-line">
                    <p{{ page_text_attr('lessons.audience.body') }}>{{ 'lessons.audience.body'|trans({}, 'content') }}</p>
                </div>
            </div>
        </div>
    </section>

    <section class="sc-section sc-section--surface">
        <div class="container">
            <h2{{ page_text_attr('lessons.teacher.heading') }}>{{ 'lessons.teacher.heading'|trans({}, 'content') }}</h2>
            <hr class="sc-accent-line">
            <p class="col-lg-8"{{ page_text_attr('lessons.teacher.body') }}>{{ 'lessons.teacher.body'|trans({}, 'content') }}</p>
            <a href="{{ path('app_about') }}"{{ page_text_attr('lessons.teacher.link') }}>{{ 'lessons.teacher.link'|trans({}, 'content') }}</a>
        </div>
    </section>

    <section class="sc-section">
        <div class="container">
            <div class="row g-5">
                <div class="col-md-4">
                    <h2{{ page_text_attr('lessons.location.heading') }}>{{ 'lessons.location.heading'|trans({}, 'content') }}</h2>
                    <hr class="sc-accent-line">
                    {% set address = 'lessons.location.address'|trans({}, 'content') %}
                    <address{{ page_text_attr('lessons.location.address') }}>{{ address|nl2br }}</address>
                    <a href="https://www.google.com/maps/search/?api=1&query={{ address|replace({"\n": ', '})|url_encode }}" rel="noopener"{{ page_text_attr('lessons.location.map_link') }}>{{ 'lessons.location.map_link'|trans({}, 'content') }}</a>
                </div>
                <div class="col-md-4">
                    <h2{{ page_text_attr('lessons.dates.heading') }}>{{ 'lessons.dates.heading'|trans({}, 'content') }}</h2>
                    <hr class="sc-accent-line">
                    <p{{ page_text_attr('lessons.dates.body') }}>{{ 'lessons.dates.body'|trans(site.lessonParameters, 'content') }}</p>
                </div>
                <div class="col-md-4">
                    <h2{{ page_text_attr('lessons.prices.heading') }}>{{ 'lessons.prices.heading'|trans({}, 'content') }}</h2>
                    <hr class="sc-accent-line">
                    <p{{ page_text_attr('lessons.prices.body') }}>{{ 'lessons.prices.body'|trans(site.lessonParameters, 'content') }}</p>
                </div>
            </div>
        </div>
    </section>

    {# Texts by Sonja, hidden while empty; in edit mode an empty section shows a placeholder to click (cms.md K4) #}
    {% for section in ['rules', 'faq'] %}
        {% set key = 'lessons.' ~ section %}
        {% set body = (key ~ '.body')|trans({}, 'content') %}
        {% if body is not empty or page_text_editor() %}
            <section class="sc-section{{ body is empty ? ' sc-page-text-hidden' }}">
                <div class="container">
                    <h2{{ page_text_attr(key ~ '.heading') }}>{{ (key ~ '.heading')|trans({}, 'content') }}</h2>
                    <hr class="sc-accent-line">
                    {% if body is not empty %}
                        {{ text.paragraphs(body, '', page_text_attr(key ~ '.body')) }}
                    {% else %}
                        {{ include('_partials/page_text_empty.html.twig', {key: key ~ '.body'}) }}
                    {% endif %}
                </div>
            </section>
        {% endif %}
    {% endfor %}

    <section class="sc-section sc-section--surface">
        <div class="container">
            <h2{{ page_text_attr('lessons.inquiry.heading') }}>{{ 'lessons.inquiry.heading'|trans({}, 'content') }}</h2>
            <hr class="sc-accent-line">
            <div class="col-lg-8">
                <p{{ page_text_attr('lessons.inquiry.body') }}>{{ 'lessons.inquiry.body'|trans({}, 'content') }}</p>
                <p class="small"{{ page_text_attr('lessons.inquiry.minor_hint') }}>{{ 'lessons.inquiry.minor_hint'|trans({}, 'content') }}</p>
                <p class="small"><a href="{{ path('app_privacy_lessons') }}">{{ 'title.privacy_lessons'|trans }}</a></p>
                {{ include('_partials/inquiry_form.html.twig', {
                    form: form,
                    status: inquiry_status,
                    sent: inquiry_sent,
                    page_url: path('app_lessons'),
                    address: 'informal',
                }) }}
            </div>
        </div>
    </section>
{% endblock %}
