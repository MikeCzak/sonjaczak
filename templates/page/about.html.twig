{% extends 'base.html.twig' %}
{% import '_macros/text.html.twig' as text %}

{% block title %}{{ 'title.about'|trans }}{% endblock %}
{% block meta_description %}{{ 'meta.about'|trans }}{% endblock %}

{% block body %}
    <section class="sc-section">
        <div class="container">
            <div class="row g-5 align-items-center">
                <div class="col-lg-7">
                    <h1>{{ 'title.about'|trans }}</h1>
                    <hr class="sc-accent-line">
                    {{ text.paragraphs('about.body'|trans({}, 'content')) }}
                    <p class="d-flex flex-wrap gap-3 mt-4 mb-0">
                        <a class="btn btn-primary" href="{{ path('app_booking') }}">{{ 'nav.booking'|trans }}</a>
                        <a class="btn btn-outline-primary" href="{{ path('app_lessons') }}">{{ 'nav.lessons'|trans }}</a>
                    </p>
                </div>
                <div class="col-lg-5">
                    <img class="img-fluid rounded sc-portrait" src="{{ asset('images/hero-sonja.jpg') }}"
                         alt="{{ 'about.image_alt'|trans({}, 'content') }}" width="1920" height="1277" loading="lazy">
                </div>
            </div>
        </div>
    </section>
{% endblock %}
