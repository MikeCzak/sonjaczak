{% extends 'base.html.twig' %}
{% import '_macros/text.html.twig' as text %}

{% block title %}{{ 'title.privacy_lessons'|trans }}{% endblock %}
{% block meta_description %}{{ 'meta.privacy_lessons'|trans }}{% endblock %}

{% block body %}
    <section class="sc-section">
        <div class="container">
            <div class="sc-prose">
            <h1>{{ 'title.privacy_lessons'|trans }}</h1>
            <hr class="sc-accent-line">
            <p>{{ 'privacy_lessons.intro'|trans({}, 'content') }}</p>
            <p>
                {{ 'privacy_lessons.website_notice'|trans({}, 'content') }}
                <a href="{{ path('app_privacy') }}">{{ 'inquiry.privacy_link'|trans }}</a>.
            </p>

            <h2 class="h4 mt-5">{{ 'privacy.controller.heading'|trans({}, 'content') }}</h2>
            {{ include('_partials/controller_address.html.twig') }}

            {% for section in ['data', 'purpose', 'required', 'recipients', 'storage'] %}
                <h2 class="h4 mt-5">{{ ('privacy_lessons.' ~ section ~ '.heading')|trans({}, 'content') }}</h2>
                {{ text.paragraphs(('privacy_lessons.' ~ section ~ '.body')|trans({}, 'content')) }}
            {% endfor %}

            {# Same rights as on the website, one text for both #}
            <h2 class="h4 mt-5">{{ 'privacy.rights.heading'|trans({}, 'content') }}</h2>
            {{ text.paragraphs('privacy.rights.body'|trans({}, 'content')) }}

            <p class="text-body-secondary mt-5 mb-0">{{ 'privacy.updated'|trans({}, 'content') }}</p>
            </div>
        </div>
    </section>
{% endblock %}
