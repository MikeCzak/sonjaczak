{% extends 'base.html.twig' %}

{% block title %}{{ 'title.privacy_lessons'|trans }}{% endblock %}
{% block meta_description %}{{ 'meta.privacy_lessons'|trans }}{% endblock %}

{% block body %}
    <section class="sc-section">
        <div class="container">
            <div class="sc-prose">
            <h1>{{ 'title.privacy_lessons'|trans }}</h1>
            <hr class="sc-accent-line">
            <p><a href="{{ path('app_privacy_lessons_pdf') }}">{{ 'action.open_pdf'|trans }}</a></p>

            {{ include('page/_privacy_lessons_sections.html.twig') }}

            <p class="text-body-secondary mt-5 mb-0"{{ page_text_attr('privacy.updated') }}>{{ 'privacy.updated'|trans({}, 'content') }}</p>
            </div>
        </div>
    </section>
{% endblock %}
