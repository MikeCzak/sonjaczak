{% extends 'base.html.twig' %}
{% import '_macros/text.html.twig' as text %}

{% block title %}{{ 'title.privacy'|trans }}{% endblock %}
{% block meta_description %}{{ 'meta.privacy'|trans }}{% endblock %}

{% block body %}
    <section class="sc-section">
        <div class="container">
            <div class="sc-prose">
            <h1>{{ 'title.privacy'|trans }}</h1>
            <hr class="sc-accent-line">
            <p{{ page_text_attr('privacy.intro') }}>{{ 'privacy.intro'|trans({}, 'content') }}</p>
            <p>
                <span{{ page_text_attr('privacy.lessons_notice') }}>{{ 'privacy.lessons_notice'|trans({}, 'content') }}</span>
                <a href="{{ path('app_privacy_lessons') }}">{{ 'title.privacy_lessons'|trans }}</a>.
            </p>

            <h2 class="h4 mt-5"{{ page_text_attr('privacy.controller.heading') }}>{{ 'privacy.controller.heading'|trans({}, 'content') }}</h2>
            {{ include('_partials/controller_address.html.twig') }}

            {% for section in ['hosting', 'logs', 'cookies', 'fonts', 'email', 'links', 'rights'] %}
                {% set key = 'privacy.' ~ section %}
                <h2 class="h4 mt-5"{{ page_text_attr(key ~ '.heading') }}>{{ (key ~ '.heading')|trans({}, 'content') }}</h2>
                {# %email% is only used in privacy.email.body #}
                {{ text.paragraphs((key ~ '.body')|trans({'%email%': contact_email}, 'content'), '', page_text_attr(key ~ '.body')) }}
            {% endfor %}

            <p class="text-body-secondary mt-5 mb-0"{{ page_text_attr('privacy.updated') }}>{{ 'privacy.updated'|trans({}, 'content') }}</p>
            </div>
        </div>
    </section>
{% endblock %}
