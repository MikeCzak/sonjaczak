{# Shown for 404 in prod (debug off); preview in dev at /_error/404 #}
{% extends 'base.html.twig' %}

{% block title %}{{ 'error.not_found.title'|trans }}{% endblock %}
{% block meta_robots %}<meta name="robots" content="noindex">{% endblock %}

{% block body %}
    <section class="sc-section">
        <div class="container">
            <p class="text-body-secondary mb-2">{{ 'error.not_found.title'|trans }} (404)</p>
            <h1>{{ 'error.not_found.heading'|trans }}</h1>
            <hr class="sc-accent-line">
            <p class="col-lg-8">{{ 'error.not_found.body'|trans }}</p>
            <p class="d-flex flex-wrap gap-3 mb-0">
                <a class="btn btn-primary" href="{{ path('app_home') }}">{{ 'error.not_found.home'|trans }}</a>
                <a class="btn btn-outline-primary" href="{{ path('app_contact') }}">{{ 'nav.contact'|trans }}</a>
            </p>
        </div>
    </section>
{% endblock %}
